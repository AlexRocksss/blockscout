NEXT_PUBLIC_API_HOST=scan.eniac.network
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_STATS_API_HOST=
NEXT_PUBLIC_NETWORK_NAME=ENI Mainnet
NEXT_PUBLIC_NETWORK_SHORT_NAME=ENI
NEXT_PUBLIC_NETWORK_ID=173
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=EGAS
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=EGAS
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_APP_HOST=scan.eniac.network
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_HOMEPAGE_CHARTS=[]
NEXT_PUBLIC_VISUALIZE_API_HOST=
NEXT_PUBLIC_IS_TESTNET=false
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss
NEXT_PUBLIC_API_SPEC_URL=https://raw.githubusercontent.com/blockscout/blockscout-api-v2-swagger/main/swagger.yaml

# blockchain parameters
NEXT_PUBLIC_NETWORK_RPC_URL=https://rpc.eniac.network/

# ui config
## homepage
NEXT_PUBLIC_HOMEPAGE_PLATE_TEXT_COLOR=white
NEXT_PUBLIC_HOMEPAGE_PLATE_BACKGROUND=linear-gradient(120deg, rgba(49,212,152,1), rgba(24,113,222,1), rgba(51,0,255,1))
# ## sidebar
NEXT_PUBLIC_NETWORK_LOGO=https://raw.githubusercontent.com/ryanguorl/blockscout/eni-mainnet-v6.6.0/apps/block_scout_web/assets/static/images/blockscout_logo.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=https://raw.githubusercontent.com/ryanguorl/blockscout/eni-mainnet-v6.6.0/apps/block_scout_web/assets/static/images/blockscout_logo_dark.svg
NEXT_PUBLIC_NETWORK_ICON=https://raw.githubusercontent.com/ryanguorl/blockscout/eni-mainnet-v6.6.0/apps/block_scout_web/assets/static/images/favicon-32x32.png
NEXT_PUBLIC_NETWORK_ICON_DARK=https://raw.githubusercontent.com/ryanguorl/blockscout/eni-mainnet-v6.6.0/apps/block_scout_web/assets/static/images/favicon-32x32.png
## footer
NEXT_PUBLIC_FOOTER_LINKS=https://raw.githubusercontent.com/ryanguorl/frontend/eni-v1.31.0/configs/footer-links.json
NEXT_PUBLIC_VIEWS_BLOCK_HIDDEN_FIELDS=["burnt_fees"]
NEXT_PUBLIC_VIEWS_TX_HIDDEN_FIELDS=["burnt_fees"]

# app features
NEXT_PUBLIC_GAS_TRACKER_ENABLED=true
NEXT_PUBLIC_NAVIGATION_HIDDEN_LINKS=["eth_rpc_api","rpc_api"]
NEXT_PUBLIC_VIEWS_ADDRESS_HIDDEN_VIEWS=["top_accounts"]

## banner ads
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
## text ads
NEXT_PUBLIC_AD_TEXT_PROVIDER=none
# blockchain interaction
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID= # project id from wallet connect
## csv export
NEXT_PUBLIC_RE_CAPTCHA_APP_SITE_KEY= # recaptcha app site key

#meta
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false
NEXT_PUBLIC_OG_DESCRIPTION='ENI is a high-performance blockchain with parallel computing and triple consensus, offering modular, scalable Web3 solutions for enterprises and developers.'
NEXT_PUBLIC_OG_IMAGE_URL=https://raw.githubusercontent.com/ryanguorl/blockscout/eni-mainnet-v6.6.0/apps/block_scout_web/assets/static/images/blockscout_logo.svg
NEXT_PUBLIC_OG_ENHANCED_DATA_ENABLED=true
NEXT_PUBLIC_SEO_ENHANCED_DATA_ENABLED=true
