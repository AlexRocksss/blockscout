map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Extract only the first (real client) IP from X-Forwarded-For header
map $http_x_forwarded_for $real_client_ip {
    ~^(?P<first>[^,]+) $first;
    default             $remote_addr;
}

# Classify request by API key — 0 = no/invalid key, 1 = valid key
map $http_x_api_key $api_key_tier {
    default            0;
    # "your-key-2"     1;
}

# Classify request by IP — 0 = normal, 1 = whitelisted
geo $real_client_ip $ip_tier {
    default        0;
    # 10.0.0.0/8   1;
}

# Normal key — only set for normal users, empty for privileged
map "$api_key_tier:$ip_tier" $normal_key {
    ~^1:    "";
    ~^0:1   "";
    default $real_client_ip;
}

# Whitelist key — only set for whitelisted IPs, empty for others
map "$api_key_tier:$ip_tier" $whitelist_key {
    ~^0:1   "whitelist";
    default "";
}

# API key — only set for valid API key users, empty for others
map "$api_key_tier:$ip_tier" $api_key_value {
    ~^1:    $http_x_api_key;
    default "";
}

# Three independent zones — each request only ever hits one
limit_req_zone $normal_key    zone=api_normal:10m    rate=10r/s;
limit_req_zone $whitelist_key zone=api_whitelist:10m rate=100r/s;
limit_req_zone $api_key_value zone=api_key:10m       rate=100r/s;
limit_req_status 429;

server {
    listen       80;
    server_name  localhost;
    proxy_http_version 1.1;

    # Stats API — internal routing to stats service
    location ~ ^/api/v1/(pages|lines|counters) {
        proxy_pass http://127.0.0.1:8080;
    }

    # Visualizer API — internal routing to visualizer service
    location ~ ^/api/v1/(solidity) {
        proxy_pass http://127.0.0.1:8081;
    }

    # Main API — rate limited
    location ~ ^/(api(?!-docs$)|socket|sitemap.xml|auth/auth0|auth/auth0/callback|auth/logout) {
        # Strip backend CORS headers to prevent duplicates
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Expose-Headers;

        limit_req zone=api_normal    burst=20  nodelay;
        limit_req zone=api_whitelist burst=200 nodelay;
        limit_req zone=api_key       burst=200 nodelay;

        # CORS preflight
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin'      '$http_origin' always;
            add_header 'Access-Control-Allow-Methods'     'GET, POST, OPTIONS, PUT, DELETE, PATCH' always;
            add_header 'Access-Control-Allow-Headers'     'DNT,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,x-csrf-token,X-API-Key' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Max-Age'           1728000;
            add_header 'Content-Type'                     'text/plain charset=UTF-8';
            add_header 'Content-Length'                   0;
            return 204;
        }

        # CORS headers for all other requests
        add_header 'Access-Control-Allow-Origin'      '$http_origin' always;
        add_header 'Access-Control-Allow-Methods'     'GET, POST, OPTIONS, PUT, DELETE, PATCH' always;
        add_header 'Access-Control-Allow-Headers'     'DNT,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,x-csrf-token,X-API-Key' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;

        proxy_pass            ${BACK_PROXY_PASS};
        proxy_http_version    1.1;
        proxy_set_header      Host "$host";
        proxy_set_header      X-Real-IP "$remote_addr";
        proxy_set_header      X-Forwarded-For "$proxy_add_x_forwarded_for";
        proxy_set_header      X-Forwarded-Proto "$scheme";
        proxy_set_header      Upgrade "$http_upgrade";
        proxy_set_header      Connection $connection_upgrade;
        proxy_cache_bypass    $http_upgrade;
    }

    location / {
        proxy_pass            ${FRONT_PROXY_PASS};
        proxy_http_version    1.1;
        proxy_set_header      Host "$host";
        proxy_set_header      X-Real-IP "$remote_addr";
        proxy_set_header      X-Forwarded-For "$proxy_add_x_forwarded_for";
        proxy_set_header      X-Forwarded-Proto "$scheme";
        proxy_set_header      Upgrade "$http_upgrade";
        proxy_set_header      Connection $connection_upgrade;
        proxy_cache_bypass    $http_upgrade;

        proxy_buffer_size       128k;
        proxy_buffers           4 256k;
        proxy_busy_buffers_size 256k;
    }
}

server {
    listen       8080;
    server_name  _;
    proxy_http_version 1.1;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Methods;
    add_header 'Access-Control-Allow-Origin'      '$http_origin' always;
    add_header 'Access-Control-Allow-Credentials' 'true' always;
    add_header 'Access-Control-Allow-Methods'     'PUT, GET, POST, OPTIONS, DELETE, PATCH' always;

    location / {
        proxy_pass            http://stats:8050/;
        proxy_http_version    1.1;
        proxy_set_header      Host "$host";
        proxy_set_header      X-Real-IP "$remote_addr";
        proxy_set_header      X-Forwarded-For "$proxy_add_x_forwarded_for";
        proxy_set_header      X-Forwarded-Proto "$scheme";
        proxy_set_header      Upgrade "$http_upgrade";
        proxy_set_header      Connection $connection_upgrade;
        proxy_cache_bypass    $http_upgrade;
    }
}

server {
    listen       8081;
    server_name  _;
    proxy_http_version 1.1;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Methods;
    add_header 'Access-Control-Allow-Origin'      '$http_origin' always;
    add_header 'Access-Control-Allow-Credentials' 'true' always;
    add_header 'Access-Control-Allow-Methods'     'PUT, GET, POST, OPTIONS, DELETE, PATCH' always;
    add_header 'Access-Control-Allow-Headers'     'DNT,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,x-csrf-token' always;

    location / {
        proxy_pass            http://visualizer:8050/;
        proxy_http_version    1.1;
        proxy_buffering       off;
        proxy_set_header      Host "$host";
        proxy_set_header      X-Real-IP "$remote_addr";
        proxy_connect_timeout 30m;
        proxy_read_timeout    30m;
        proxy_send_timeout    30m;
        proxy_set_header      X-Forwarded-For "$proxy_add_x_forwarded_for";
        proxy_set_header      X-Forwarded-Proto "$scheme";
        proxy_set_header      Upgrade "$http_upgrade";
        proxy_set_header      Connection $connection_upgrade;
        proxy_cache_bypass    $http_upgrade;

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin'      '$http_origin' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods'     'PUT, GET, POST, OPTIONS, DELETE, PATCH' always;
            add_header 'Access-Control-Allow-Headers'     'DNT,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,x-csrf-token' always;
            add_header 'Access-Control-Max-Age'           1728000;
            add_header 'Content-Type'                     'text/plain charset=UTF-8';
            add_header 'Content-Length'                   0;
            return 204;
        }
    }
}
